{
  "name": "wantok-service",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "db:start": "node ./scripts/supabase-local.js start",
    "db:status": "node ./scripts/supabase-local.js status",
    "db:migrate": "node ./scripts/supabase-local.js migration up --local",
    "db:reset": "node ./scripts/supabase-local.js db reset --local",
    "db:test": "node ./scripts/supabase-local.js test db --local supabase/tests",
    "test:evidence": "node --test --test-reporter=tap ./packages/evidence_scanner/test/scan.test.mjs ./packages/evidence_scanner/test/quarantine.test.mjs ./packages/evidence_scanner/test/admission.test.mjs ./packages/evidence_scanner/test/freshness.test.mjs ./packages/evidence_scanner/test/custody.test.mjs ./packages/evidence_scanner/test/custody-reconcile.test.mjs",
    "test:evidence:real": "node --test --test-reporter=tap ./packages/evidence_scanner/test/real-clamd.test.mjs",
    "db:stop": "node ./scripts/supabase-local.js stop"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.80.0",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.10",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.7",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.8",
    "expo-web-browser": "~15.0.11",
    "maplibre-gl": "^6.11.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "supabase": "^2.119.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
