WANTOK_DOMAIN=wantok-service.com
ACME_EMAIL=admin@wantok-service.com

# Official Supabase self-host runtime location/version.
SUPABASE_PROJECT_DIR=/opt/wantok-service/runtime/supabase
SUPABASE_SELF_HOST_REF=self-hosted/v0.8.2
SUPABASE_DOCKER_NETWORK=supabase_default
SUPABASE_API_UPSTREAM=api-gw:8000

# Local-only direct PostgreSQL port used by controlled migration/backup tooling.
WANTOK_DB_PORT=54322

# CLI version used by the migration helper when the host has no local Supabase CLI.
SUPABASE_CLI_VERSION=2.119.0

# These are filled/synchronised by provision-supabase.sh.
# The publishable key is safe for public clients; DATABASE_URL is private.
SUPABASE_PUBLISHABLE_KEY=auto
DATABASE_URL=auto

WANTOK_BACKUP_DIR=/opt/wantok-service/backups
